# --- ACRCloud (fallback music recognition) ---
# Create a project at https://console.acrcloud.com → Audio & Video Recognition
# Example host: identify-ap-southeast-1.acrcloud.com  (host only, no protocol)
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# --- DJ Pool Records account (optional, for downloading matched tracks) ---
DJPOOL_EMAIL=
DJPOOL_PASSWORD=

# --- Optional binary overrides (auto-detected from PATH when empty) ---
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
