# --- Google sign-in (required — the app is unusable without login) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). Authorized redirect URI:
#   {APP_URL}/api/auth/callback   e.g. https://demo-dj.unityx.group/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random long string used to sign session cookies (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Comma-separated Google emails allowed to sign in. Empty = any Google account.
ALLOWED_EMAILS=
# Public URL of the app, needed behind a reverse proxy for the OAuth redirect.
# APP_URL=https://demo-dj.unityx.group

# --- MySQL via Prisma (per-account Recent history) ---
# Optional. Without it, history falls back to browser localStorage (per device).
# IMPORTANT: put DATABASE_URL in `.env` (not `.env.local`) — the Prisma CLI
# only reads `.env`, and Next.js reads both.
# Start the bundled container with: docker compose up -d
# Then apply the schema with:      npx prisma migrate deploy
# DATABASE_URL=mysql://musicapp:change-me@127.0.0.1:3306/musicapp

# --- ACRCloud (fallback music recognition) ---
# Create a project at https://console.acrcloud.com → Audio & Video Recognition
# Example host: identify-ap-southeast-1.acrcloud.com  (host only, no protocol)
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# --- DJ Pool Records account (optional, for downloading matched tracks) ---
DJPOOL_EMAIL=
DJPOOL_PASSWORD=

# --- yt-dlp cookies (Netscape cookies.txt) ---
# Needed on datacenter IPs where YouTube blocks anonymous downloads.
# Export from a browser signed in to YouTube, then point this at the file.
# YTDLP_COOKIES=/home/deploy/youtube-cookies.txt

# --- Optional binary overrides (auto-detected from PATH when empty) ---
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
